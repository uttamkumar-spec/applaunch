# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=fitmovelab

# --- Supabase (auth) ---
# Project URL and the JWT secret used to verify user access tokens
# (Project Settings -> API -> JWT Settings -> JWT Secret).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Service role key — required only for admin user creation
# (Project Settings -> API -> service_role key). Server-side only, never
# ship this to the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Gemini (AI coach + AI plan generation + form checks) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Strava (progress sync) ---
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
# Must match a Strava API application's "Authorization Callback Domain"
STRAVA_REDIRECT_URI=http://localhost:5000/api/strava/callback

# --- App ---
# Comma-separated list of allowed origins for CORS (add your web/app URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FLASK_SECRET_KEY=change-me
PORT=5000

# Rate-limit storage — defaults to in-process memory (fine for local dev /
# a single worker). If you run multiple gunicorn workers in production, set
# this to a shared Redis instance so limits are enforced consistently, e.g.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
